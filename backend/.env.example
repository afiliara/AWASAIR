# Salin menjadi .env lalu sesuaikan.

# Broker MQTT. Dev: broker lokal (npm run broker). Produksi: mqtts://host:8883
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=

PORT=3000
DB_PATH=./data/awasair.db

# Jika diisi, POST /api/cmd wajib header X-API-Key. Wajib diisi bila backend dibuka ke internet.
API_KEY=

STALE_SECONDS=30
RETENTION_DAYS=30
